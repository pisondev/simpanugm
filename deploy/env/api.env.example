# api and worker, docs/engineering/local-development.md section 6.1
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_URL=postgres://simpan_app:${SIMPAN_APP_PASSWORD}@postgres:5432/simpan
DATABASE_MIGRATOR_URL=postgres://simpan_owner:${SIMPAN_OWNER_PASSWORD}@postgres:5432/simpan
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=/var/lib/simpan/media
ML_BASE_URL=http://ml:8100
ML_INTERNAL_TOKEN=${ML_INTERNAL_TOKEN}
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=none
MAIL_FROM=SimpanUGM <no-reply@simpanugm.my.id>
SESSION_COOKIE_SECURE=false
HANDOVER_PEPPER=${HANDOVER_PEPPER}
LOG_LEVEL=info
