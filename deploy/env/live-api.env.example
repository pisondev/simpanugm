APP_ENV=production
PUBLIC_BASE_URL=https://simpanugm.pisondev.com
DATABASE_URL=postgres://simpan_app:${SIMPAN_APP_PASSWORD}@postgres:5432/simpan
DATABASE_MIGRATOR_URL=postgres://simpan_owner:${SIMPAN_OWNER_PASSWORD}@postgres:5432/simpan
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=/var/lib/simpan/media
ML_BASE_URL=
ML_INTERNAL_TOKEN=${ML_INTERNAL_TOKEN}
SMTP_HOST=mail.simpanugm.pisondev.com
SMTP_PORT=587
SMTP_USERNAME=no-reply@simpanugm.pisondev.com
SMTP_PASSWORD=replace-with-generated-mailbox-password
SMTP_TLS=starttls
MAIL_FROM=SimpanUGM <no-reply@simpanugm.pisondev.com>
SESSION_COOKIE_SECURE=true
HANDOVER_PEPPER=${HANDOVER_PEPPER}
LOG_LEVEL=info
AUTH_REGISTER_PER_HOUR=5
AUTH_LOGIN_IP_PER_15_MINUTES=20
AUTH_LOGIN_PAIR_PER_15_MINUTES=5
