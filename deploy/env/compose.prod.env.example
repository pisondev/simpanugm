# Production compose environment variables template (deployment.md section 2 and 7)
# Store with mode 600 in /opt/simpanugm/env/compose.env
VERSION=v1.0.0
SITE_ADDRESS=simpanugm.my.id
HTTP_PORT=80
POSTGRES_PASSWORD=generate-strong-random-password-here
SIMPAN_OWNER_PASSWORD=generate-strong-random-password-here
SIMPAN_APP_PASSWORD=generate-strong-random-password-here
SIMPAN_READONLY_PASSWORD=generate-strong-random-password-here
BACKUP_DIR=/opt/simpanugm/backups
METRICS_DIR=/opt/simpanugm/metrics
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/root/.restic_password
