{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Database Connection Pool (Acquired vs Idle)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(db_pool_acquired_conns) by (service)",
          "legendFormat": "Acquired ({{service}})"
        },
        {
          "expr": "sum(db_pool_idle_conns) by (service)",
          "legendFormat": "Idle ({{service}})"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Cache Hit Ratio",
      "type": "gauge",
      "targets": [
        {
          "expr": "sum(pg_stat_database_blks_hit) / (sum(pg_stat_database_blks_hit) + sum(pg_stat_database_blks_read)) * 100",
          "legendFormat": "Hit Ratio %"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "Slow Queries (Calls / Execution Time)",
      "type": "table",
      "targets": [
        {
          "expr": "topk(10, pg_stat_statements_total_exec_time)",
          "legendFormat": "Query: {{query}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "id": 4,
      "title": "Database Size",
      "type": "stat",
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname=\"simpan\"}",
          "legendFormat": "Bytes"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "id": 5,
      "title": "Backup Age",
      "type": "stat",
      "targets": [
        {
          "expr": "time() - backup_last_success_timestamp_seconds",
          "legendFormat": "Seconds since backup"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["simpanugm", "database"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "SimpanUGM - Database",
  "version": 1
}
